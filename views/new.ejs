<%- include('./header.ejs') -%>

<div class="glass-card form-card">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h3 class="mb-0 fw-bold"><i class="fa-solid fa-clapperboard text-indigo me-2"></i>Add New Movie</h3>
    <a href="/" class="btn btn-outline-light btn-sm rounded-pill"><i class="fa-solid fa-xmark"></i> Cancel</a>
  </div>

  <form action="/create" method="POST">
    <div class="mb-3">
      <label for="name" class="form-label-custom">Movie Title</label>
      <input type="text" name="name" id="name" class="form-control form-control-custom" placeholder="e.g. Inception" required>
    </div>

    <div class="mb-3">
      <label for="year" class="form-label-custom">Release Year</label>
      <input type="number" name="year" id="year" class="form-control form-control-custom" placeholder="e.g. 2010" min="1880" max="2100">
    </div>

    <div class="mb-3">
      <label for="img" class="form-label-custom">Poster Image URL</label>
      <input type="url" name="img" id="img" class="form-control form-control-custom" placeholder="https://image.tmdb.org/t/p/w500/...">
      <small class="text-muted">Leave blank for default poster</small>
    </div>

    <div class="mb-4">
      <label for="desc" class="form-label-custom">Movie Plot Description</label>
      <textarea name="desc" id="desc" rows="3" class="form-control form-control-custom" placeholder="Brief summary of the movie plot..."></textarea>
    </div>

    <button type="submit" class="btn btn-gradient-primary w-100 py-2">
      <i class="fa-solid fa-check me-2"></i>Save Movie
    </button>
  </form>
</div>

<%- include('./footer.ejs') -%>